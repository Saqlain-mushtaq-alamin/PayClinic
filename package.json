{
  "name": "payclinic",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "mocks/*"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "npm run build -w @payclinic/dashboard",
    "setup": "tsx scripts/setup.ts",
    "demo": "tsx scripts/seed-demo.ts && tsx packages/cli/src/serve.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "payclinic": "tsx packages/cli/src/cli.ts",
    "serve": "tsx packages/cli/src/serve.ts",
    "dev:mock": "npx vite apps/dashboard --host 127.0.0.1",
    "dev:real": "npx vite apps/dashboard --mode real --host 127.0.0.1",
    "record:online": "tsx scripts/record-online.ts",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
