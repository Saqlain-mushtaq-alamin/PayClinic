# ---- Mode (offline = simulator + fixtures; needs no keys) ----
PAYCLINIC_MODE=offline            # offline | online
BUYER_APPROVER=sim                # sim | manual | playwright | card   (online mode depends on spike S2)
AI_PROVIDER=fixture               # fixture | gemini | fake
AI_RECORD=0                       # 1 = save Gemini outputs into fixtures/ai/

# ---- PayPal (online mode only; SANDBOX credentials only, never live) ----
PAYPAL_BASE_URL=http://127.0.0.1:4010   # sim default. Online: https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BUYER_EMAIL=               # sandbox personal (buyer) account, for playwright/manual approver
PAYPAL_BUYER_PASSWORD=

# ---- AI (Google AI Studio free tier; each member uses their own key) ----
GEMINI_API_KEY=
GEMINI_MODEL=                     # pick the model with the best free limits (spike S3)

# ---- Ports ----
API_PORT=4000
SIM_PORT=4010
MOCK_API_PORT=4001
DASHBOARD_PORT=5173

# ---- Storage ----
DB_PATH=./data/payclinic.db

# ---- Optional ----
GITHUB_TOKEN=                     # fine-grained token, demo repo only
